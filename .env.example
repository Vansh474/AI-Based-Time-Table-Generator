# GEMINI_API_KEY: Required for Gemini AI API calls (used server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Required secret used to sign and verify JWT authentication tokens.
# Generate a strong random value (at least 32 bytes / 64 hex chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_JWT_SECRET"

# APP_URL: The URL where this applet is hosted (used for CORS allowlist).
APP_URL="MY_APP_URL"

